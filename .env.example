# Bot token (Discord portal > your app > Bot > Reset Token).
DISCORD_TOKEN=

# Application ID (Discord portal > your app > General Information).
DISCORD_CLIENT_ID=

# Your test server's ID (right-click your server icon > Copy Server ID,
# requires Developer Mode enabled). Only used by scripts/deploy-commands-dev.js
# and scripts/clear-guild-commands.js — not needed for the global deploy or
# for running the bot itself.
DISCORD_GUILD_ID=

# Free API key from https://console.groq.com (powers /ask).
GROQ_API_KEY=

# Free API key from https://developers.giphy.com (powers the automatic
# GIF replies when someone replies to the bot).
GIPHY_API_KEY=
